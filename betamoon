from fastapi import FastAPI

from app.api.routes.secrets import router as secrets_router

app = FastAPI(
    title="NexoraVault",
    description="Secure secret management API",
    version="1.0.0",
)

app.include_router(secrets_router)


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "service": "NexoraVault",
    }
